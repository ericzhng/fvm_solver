<?xml version="1.0"?>
<simulation>
    <geometry>
        <dimension>1</dimension>
        <domain>
            <xmin>0.0</xmin>
            <xmax>1.0</xmax>
        </domain>
    </geometry>
    <mesh>
        <nx>100</nx>
        <stretch_factor>1.0</stretch_factor>
    </mesh>
    <equation>
        <type>advection</type>
        <advection_speed>1.0</advection_speed>
    </equation>
    <boundary_conditions>
        <type>periodic</type>
        <left_values>
            <value>0.0</value>
        </left_values>
        <right_values>
            <value>0.0</value>
        </right_values>
    </boundary_conditions>
    <initial_conditions>
        <left>
            <value>1.0</value>
        </left>
        <right>
            <value>0.0</value>
        </right>
        <split>0.1</split>
    </initial_conditions>
    <solver_settings>
        <time_integration>euler</time_integration>
        <ghost_cells>2</ghost_cells>
        <T>0.5</T>
        <cfl>0.2</cfl>
        <flux>hllc</flux>
        <reconstruction>ppm</reconstruction>
        <reconstruction_vars>conservative</reconstruction_vars>
        <limiter>superbee</limiter>
        <max_iterations>10000</max_iterations>
        <convergence_tolerance>1e-6</convergence_tolerance>
    </solver_settings>
    <output>
        <format>csv</format>
        <filename>solution.dat</filename>
    </output>
</simulation>
