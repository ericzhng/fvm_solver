<?xml version="1.0" encoding="UTF-8"?>
<simulation>
	<geometry>
		<dimension>1</dimension>
		<domain>
			<xmin>0.0</xmin>
			<xmax>1.0</xmax>
		</domain>
	</geometry>
	<mesh>
		<nx>100</nx>
		<stretch_factor>1.0</stretch_factor>
	</mesh>
	<equation>
		<type>shallow_water</type>
		<g>9.81</g>
	</equation>
	<boundary_conditions>
		<type>neumann</type>
		<left_values>
			<height>0.0</height>
			<velocity>0.0</velocity>
		</left_values>
		<right_values>
			<height>0.0</height>
			<velocity>0.0</velocity>
		</right_values>
	</boundary_conditions>
	<initial_conditions>
		<left>
			<height>1.0</height>
			<velocity>0.0</velocity>
		</left>
		<right>
			<height>0.1</height>
			<velocity>0.0</velocity>
		</right>
		<split>0.5</split>
	</initial_conditions>
	<solver_settings>
		<time_integration>euler</time_integration>
		<ghost_cells>2</ghost_cells>
		<T>0.1</T>
		<cfl>0.2</cfl>
		<flux> </flux>
		<reconstruction>muscl</reconstruction>
		<reconstruction_vars>conservative</reconstruction_vars>
		<limiter>minmod</limiter>
		<max_iterations>10000</max_iterations>
		<convergence_tolerance>1e-6</convergence_tolerance>
	</solver_settings>
	<output>
		<format>ascii</format>
		<filename>solution.dat</filename>
	</output>
</simulation>
