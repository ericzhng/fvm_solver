<?xml version="1.0" encoding="UTF-8"?>
<simulation>
    <geometry>
        <dimension>1</dimension>
        <domain>
            <xmin>0.0</xmin>
            <xmax>1.0</xmax>
        </domain>
    </geometry>
    <mesh>
        <nx>100</nx>
        <stretch_factor>1.0</stretch_factor>
    </mesh>
    <equation>
        <type>euler</type>
        <gamma>1.4</gamma>
    </equation>
    <boundary_conditions>
        <type>neumann</type>
        <left_values>
            <density>0.0</density>
            <velocity>0.0</velocity>
            <pressure>0.0</pressure>
        </left_values>
        <right_values>
            <density>0.0</density>
            <velocity>0.0</velocity>
            <pressure>0.0</pressure>
        </right_values>
    </boundary_conditions>
    <initial_conditions>
        <euler>
            <left>
                <density>1.0</density>
                <velocity>0.0</velocity>
                <pressure>1.0</pressure>
            </left>
            <right>
                <density>0.125</density>
                <velocity>0.0</velocity>
                <pressure>0.1</pressure>
            </right>
            <split>0.5</split>
        </euler>
    </initial_conditions>
    <solver_settings>
        <T>0.1</T>
        <cfl>0.5</cfl>
        <flux>hllc</flux>
        <reconstruction>muscl</reconstruction>
        <reconstruction_vars>conservative</reconstruction_vars>
        <limiter>minmod</limiter>
        <max_iterations>10000</max_iterations>
        <convergence_tolerance>1e-6</convergence_tolerance>
    </solver_settings>
    <output>
        <format>ascii</format>
        <filename>solution.dat</filename>
    </output>
</simulation>
